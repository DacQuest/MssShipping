  <dfxSystemEventMonitorLevelSettings ConfigurationItemType="DacQuest.DFX.Core.SystemEvents.XSystemEventMonitorLevelSettingsConfigurationItem,DacQuest.DFX.Core" >
    <Information
      Display="true"
      TimeoutMinutes="60"
      MustBeAcknowledged="false"
      SaveToArchive="true"
      ControlLevel="Low"
      AllowMultipleAcknowledgment="true"
    />
    <Notification
      Display="true"
      TimeoutMinutes="14440"
      MustBeAcknowledged="false"
