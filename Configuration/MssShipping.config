  <dfxSnapInViews ConfigurationItemType="DacQuest.DFX.SnapInViews.XSnapInViewConfigurationItem,DacQuest.DFX.SnapInViews" >
    <HomeView
      ClassType="Mss.Views.HomeView, Mss.Views"
      FriendlyName="Home"
      Precreate="true"
      AutoClose="false"
      ShowInNavigator="false"
      Parameters=""
      />

    <UpperLoadDirectorView
      ClassType="Mss.Views.LoadDirectorView, Mss.Views"
      FriendlyName="Load Director"
      Precreate="false"
      AutoClose="false"
      ShowCloseButton="false"
      ShowInNavigator="false"
      Parameters="WrapperName:=LoadDirectorView
        |Level:=Upper
        |OperationName:=UpperLoadDirector
        |AllowReprintLabel:=true
        |ShowShortages:=true"
      />

    <LowerLoadDirectorView
      ClassType="Mss.Views.LoadDirectorView, Mss.Views"
      FriendlyName="Load Director"
      Precreate="false"
      AutoClose="false"
      ShowCloseButton="false"
      ShowInNavigator="false"
      Parameters="WrapperName:=LoadDirectorView
        |Level:=Lower
        |OperationName:=LowerLoadDirector
        |AllowReprintLabel:=true
