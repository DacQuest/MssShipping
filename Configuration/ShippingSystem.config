  <dfxSnapInViews ConfigurationItemType="DacQuest.DFX.SnapInViews.XSnapInViewConfigurationItem,DacQuest.DFX.SnapInViews" >
    <HomeView
      ClassType="Mss.Views.HomeView, Mss.Views"
      FriendlyName="Home"
      Precreate="true"
      AutoClose="false"
      ShowInNavigator="false"
      Parameters=""
      />

    <UpperLoadDirectorView
      ClassType="Mss.Views.LoadDirectorView, Mss.Views"
      FriendlyName="Load Director"
      Precreate="false"
      AutoClose="false"
      ShowCloseButton="false"
      ShowInNavigator="false"
      Parameters="WrapperName:=LoadDirectorView
        |Level:=Upper
        |OperationName:=UpperLoadDirector
        |AllowLabelReprint:=true
        |AllowItemEdit:=false"
      />

    <LowerLoadDirectorView
      ClassType="Mss.Views.LoadDirectorView, Mss.Views"
      FriendlyName="Load Director"
      Precreate="false"
      AutoClose="false"
      ShowCloseButton="false"
      ShowInNavigator="false"
      Parameters="WrapperName:=LoadDirectorView
        |Level:=Lower
        |OperationName:=LowerLoadDirector
        |AllowLabelReprint:=true
        |AllowItemEdit:=false"
      />

    <TrailerLoadView
      ClassType="Mss.Views.LoadView, Mss.Views"
      FriendlyName="Trailer Load View"
      Precreate="false"
      AutoClose="false"
      ShowCloseButton="false"
      ShowInNavigator="false"
      Parameters="WrapperName:=LoadView
        |OperationName:=TrailerLoad
        |AllowReprintLabel:=true
        |LeftClickReprintLabel:=false
        |AllowEditItem:=false
        |AllowAcceptLoad:=true
        |AllowLimitLoad:=true
