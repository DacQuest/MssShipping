  <!-- ===================================================================================================================== -->

  <dfxValueValidatorSets ConfigurationItemType="DacQuest.DFX.Core.Configuration.XValueValidatorSetConfigurationItem, DacQuest.DFX.Core" >

    <PalletIDValidator
      ValueValidatorNames="
        Row1PalletIDValidator,
        Row2U725PalletIDValidator,
        RowP703PalletIDValidator"
      ValidationOperator="Or"
      />
    <Row2PalletIDValidator
      ValueValidatorNames="
        Row2U725PalletIDValidator,
        RowP703PalletIDValidator"
      ValidationOperator="Or"
      />
    <RearSkuValidator
      ValueValidatorNames="
        U725SkuValidator,
        P703SkuValidator"
      ValidationOperator="Or"
      />
    <!--<FiftyFiftySkuValidator
      ValueValidatorNames="
        FiftyFiftySkuValidator1,
        FiftyFiftySkuValidator2"
      ValidationOperator="And"
      />
    <SixtyFortySkuValidator
      ValueValidatorNames="
        SixtyFortySkuValidator1,
        SixtyFortySkuValidator2"
      ValidationOperator="And"
      />-->

  </dfxValueValidatorSets>

  <!-- ===================================================================================================================== -->

  <dfxValueValidators ConfigurationItemType="DacQuest.DFX.Core.Configuration.XValueValidatorConfigurationItem, DacQuest.DFX.Core" >

    <SpecialPicksVinValidator
      ValueDataType="String"
      ValidationMethod="StringPattern"
      StringPatternNames="SpecialPicksVinPattern"
    />
    <Row1PalletIDValidator
      ValueDataType="Int32"
      ValidationMethod="IntegerRange"
      RangeMinimum="1000"
      IncludeMinInRange="true"
      RangeMaximum="2999"
      IncludeMaxInRange="true"
      />
    <!---Bronco-->
    <Row2U725PalletIDValidator
      ValueDataType="Int32"
      ValidationMethod="IntegerRange"
      RangeMinimum="3000"
      IncludeMinInRange="true"
      RangeMaximum="4999"
      IncludeMaxInRange="true"
      />
    <!---Ranger-->
    <RowP703PalletIDValidator
      ValueDataType="Int32"
      ValidationMethod="IntegerRange"
      RangeMinimum="5000"
      IncludeMinInRange="true"
      RangeMaximum="6999"
      IncludeMaxInRange="true"
      />

    <FrontSkuValidator
      ValueDataType="String"
      ValidationMethod="StringPattern"
      StringPatternNames="FrontSkuPattern"
    />
    <U725SkuValidator
      ValueDataType="String"
      ValidationMethod="StringPattern"
      StringPatternNames="U725SkuPattern"
    />
    <P703SkuValidator
      ValueDataType="String"
      ValidationMethod="StringPattern"
      StringPatternNames="P703SkuPattern"
    />

    <CustomHoldCodeValidator
      ValueDataType="Int32"
      ValidationMethod="IntegerRange"
      RangeMinimum="256"
      IncludeMinInRange="true"
      RangeMaximum="1000"
      IncludeMaxInRange="true"
      />

  </dfxValueValidators>

  <!-- ===================================================================================================================== -->

  <dfxStringPatterns ConfigurationItemType="DacQuest.DFX.Core.Strings.XStringPatternConfigurationItem, DacQuest.DFX.Core">
    <SpecialPicksVinPattern
      Pattern="$$$#####"
      IgnoreCase="false"
      IsRegex="false"
      />
    <FrontSkuPattern
      Pattern="%[BbRr]1%%%%"
      IgnoreCase="false"
      IsRegex="false"
      />
    <U725SkuPattern
      Pattern="%[Bb]2%%%%"
      IgnoreCase="false"
      IsRegex="false"
      />
    <P703SkuPattern
      Pattern="%[Rr]2%%%%"
      IgnoreCase="false"
      IsRegex="false"
      />
  </dfxStringPatterns>

  <!-- ===================================================================================================================== -->

  <dfxLanguageStrings ConfigurationItemType="DacQuest.DFX.Core.Configuration.XLanguageStringConfigurationItem, DacQuest.DFX.Core" >
    <DacQuest.DFX.Operations.XOperationStatus.PausePending Value="Pause Pending" />
