    <SharedCollectionService
      ClassType="DacQuest.DFX.Core.DataItems.Collections.XSharedCollectionService, DacQuest.DFX.Core"
      StartMode="Automatic"
      AutoLog="false"
      HeartbeatSeconds ="0"
